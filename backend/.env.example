# SQL Server connection (Windows Authentication, local default instance)
DB_SERVER=localhost
DB_NAME=KidsWare
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUSTED_CONNECTION=yes
DB_TRUST_SERVER_CERTIFICATE=yes

# JWT
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# File uploads
UPLOAD_BASE_DIR=app/uploads
SIZECHART_SUBDIR=SizeChartsUpload
DRESS_IMAGES_SUBDIR=dressuploads
UPLOAD_BASE_URL=/uploads

# Razorpay (get test-mode keys from https://dashboard.razorpay.com -> Settings -> API Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
ENABLE_BUY_NOW=true

# WhatsApp (wa.me deep link, no API approval needed)
WHATSAPP_NUMBER=91XXXXXXXXXX
WHATSAPP_MESSAGE_TEMPLATE=Hi! I'm interested in this dress:

# Product description translation (MyMemory free API - no key needed).
# Optional: setting an email raises the free daily translation quota.
MYMEMORY_EMAIL=
