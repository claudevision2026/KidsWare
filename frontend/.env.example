# Razorpay (test-mode Key ID from https://dashboard.razorpay.com -> Settings -> API Keys)
VITE_RAZORPAY_KEY_ID=

# Feature flag: Buy Now / Razorpay checkout is hidden by default (payment gateway not ready yet).
# The "How to Buy" page (WhatsApp / PhonePe / QR) is shown instead. Set to true once Razorpay is live.
VITE_ENABLE_BUY_NOW=false

# WhatsApp deep link (wa.me) - number in E.164 without '+', e.g. 91XXXXXXXXXX
# This same number is used as the business's WhatsApp AND UPI (PhonePe/Google Pay) payment number.
VITE_WHATSAPP_NUMBER=91XXXXXXXXXX
VITE_WHATSAPP_MESSAGE_TEMPLATE=Hi! I'm interested in this dress:

# Business name shown on the "How to Buy" page so customers can verify who they're paying
VITE_BUSINESS_NAME=KidsTrendyware

# QR code image for the "How to Buy" page: place payment-qr.png (or .jpg) in
# frontend/public/qr-code/ - no code changes needed, it's served as a static file.
